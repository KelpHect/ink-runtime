#version 460

// matvec_f8e4m3_seq.comp — row-batched f8e4m3 GEMV for chunked prefill.
//
// Identical math to matvec_f8e4m3.comp; gl_WorkGroupID.y is the row t:
//   out[t*pc.M + m] = sum_k f8e4m3(W[m,k]) * x[t*pc.xs + k]
// grid = (M, T). K % 4 == 0 (u32 row alignment), as the base shader.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer WBuf { uint w[]; }; // [M,K] u8 packed 4/u32
layout(set = 0, binding = 1, std430) readonly buffer XBuf { float x[]; }; // [T*xs] f32
layout(set = 0, binding = 2, std430) writeonly buffer OBuf { float o[]; }; // [T,M] f32

layout(push_constant) uniform Pc {
    uint K;
    uint m0;
    uint xs;
    uint M;
} pc;

shared float red[64];

float f8e4m3_to_f32(uint v) {
    uint s = v >> 7, e = (v >> 3) & 0xFu, m = v & 7u;
    float x = (e == 0u) ? ldexp(float(m) / 8.0, -6)
                        : ldexp(1.0 + float(m) / 8.0, int(e) - 7);
    return s != 0u ? -x : x;
}

float w_at(uint elem) {
    uint b = (w[elem >> 2] >> ((elem & 3u) * 8u)) & 0xFFu;
    return f8e4m3_to_f32(b);
}

void main() {
    const uint m = pc.m0 + gl_WorkGroupID.x;
    const uint t = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationID.x;
    const uint base = m * pc.K;
    const uint xb = t * pc.xs;

    float acc = 0.0;
    for (uint k = tid; k < pc.K; k += 64u)
        acc += w_at(base + k) * x[xb + k];

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) o[t * pc.M + m] = red[0];
}
