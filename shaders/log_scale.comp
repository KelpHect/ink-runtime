#version 460

// log_scale.comp — in-place scalar multiply: v[i] *= tau.
//
// Mirrors the log-scaling block of ops.cpp::attn_step (full-attn layers only):
//   tau = 1 + log_scaling_alpha * log(max((pos+1)/log_scaling_n_floor, 1))
// applied to every q and r element. tau is computed by the HOST in double
// precision (matching the CPU's double math) and passed here as fp32.
// One thread per element. Dispatch: ceil(n/64) workgroups.
// Use once for q (n = HQ*DH = 3072) and once for r (n = HQ*DR = 384).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer VBuf { float v[]; };  // [n] rw

layout(push_constant) uniform Pc {
    uint  n;
    float tau;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    v[i] *= pc.tau;
}
