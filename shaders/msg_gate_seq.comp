#version 460

// msg_gate_seq.comp — batched rank-64 message gate (loop layers, pass >= 1).
//
// Identical math to msg_gate.comp; gl_WorkGroupID.x is the prompt row t:
//   rd, rm = unweighted rstd of dst row / msg row (eps 1e-6)
//   cat[k] = k < D ? dst[t*ds+k]*rd : msg[t*ms+k-D]*rm
//   h[r]   = bf16_round( down[r,:] . bf16(cat) )
//   out[t*os+d] = (1-tanh(forget[d,:].h))*dst[t*ds+d] + tanh(gain[d,:].h)*msg[t*ms+d]
//   b0 ro u32 DOWN  b1 ro FORGET  b2 ro GAIN  b3 ro DST[T*ds]
//   b4 ro MSG[T*ms]  b5 wo OUT[T*os]

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer DBuf { uint  dn[]; };
layout(set = 0, binding = 1, std430) readonly buffer FBuf { float fw[]; };
layout(set = 0, binding = 2, std430) readonly buffer GBuf { float gw[]; };
layout(set = 0, binding = 3, std430) readonly buffer XBuf { float dst[]; };
layout(set = 0, binding = 4, std430) readonly buffer MBuf { float msg[]; };
layout(set = 0, binding = 5, std430) writeonly buffer OBuf { float o[]; };

layout(push_constant) uniform Pc {
    uint D;
    uint rank;
    uint ds;   // dst row stride
    uint ms;   // msg row stride
    uint os;   // out row stride
} pc;

shared float red[64];
shared float h[64];
shared float rr[2];

float bf16_round(float f) {
    uint u = floatBitsToUint(f);
    u += 0x7FFFu + ((u >> 16) & 1u);
    return uintBitsToFloat(u & 0xFFFF0000u);
}
float bf16_at(uint elem) {
    return uintBitsToFloat(((dn[elem >> 1] >> ((elem & 1u) * 16u)) & 0xFFFFu) << 16);
}

void main() {
    const uint t   = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;
    const uint db  = t * pc.ds;
    const uint mb  = t * pc.ms;

    float sd = 0.0, sm = 0.0;
    for (uint i = tid; i < pc.D; i += 64u) {
        float vd = dst[db + i], vm = msg[mb + i];
        sd += vd * vd; sm += vm * vm;
    }
    red[tid] = sd; barrier();
    for (uint s = 32u; s > 0u; s >>= 1) { if (tid < s) red[tid] += red[tid + s]; barrier(); }
    if (tid == 0u) rr[0] = 1.0 / sqrt(red[0] / float(pc.D) + 1e-6);
    barrier();
    red[tid] = sm; barrier();
    for (uint s = 32u; s > 0u; s >>= 1) { if (tid < s) red[tid] += red[tid + s]; barrier(); }
    if (tid == 0u) rr[1] = 1.0 / sqrt(red[0] / float(pc.D) + 1e-6);
    barrier();

    if (tid < pc.rank) {
        const uint base = tid * 2u * pc.D;
        float acc = 0.0;
        for (uint k = 0u; k < 2u * pc.D; k++) {
            float cv = (k < pc.D) ? dst[db + k] * rr[0] : msg[mb + k - pc.D] * rr[1];
            acc += bf16_at(base + k) * bf16_round(cv);
        }
        h[tid] = bf16_round(acc);
    }
    barrier();

    for (uint d = tid; d < pc.D; d += 64u) {
        float fr = 0.0, gn = 0.0;
        for (uint r = 0u; r < pc.rank; r++) {
            fr += fw[d * pc.rank + r] * h[r];
            gn += gw[d * pc.rank + r] * h[r];
        }
        o[t * pc.os + d] = (1.0 - tanh(fr)) * dst[db + d] + tanh(gn) * msg[mb + d];
    }
}
