#version 460

// matvec_mxfp8_mslot.comp — expert GEMV over MXFP8 weights, merged slots.
//
// Identical math to matvec_mxfp8_slot.comp, but the SLOT index is
// gl_WorkGroupID.y — one dispatch covers all top-k slots
// (see matvec_nvfp4_mslot.comp for the why).
//
//   acc = sum_k F8E4M3(W[e,r,k]) * UE8M0(S[e,r,k/32]) * x[k]
//   o[slot*M + m] = acc      (M = gl_NumWorkGroups.x)
//
// pc.e is unused (kept for struct-layout parity with PcMxfp8).
// Dispatch: grid = {M rows, nslots}.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer WBuf { uint  w[]; };
layout(set = 0, binding = 1, std430) readonly buffer SBuf { uint  s[]; };
layout(set = 0, binding = 2, std430) readonly buffer XBuf { float x[]; };
layout(set = 0, binding = 3, std430) buffer OBuf          { float o[]; };
layout(set = 0, binding = 4, std430) readonly buffer IBuf { int   idx[]; };

layout(push_constant) uniform Pc {
    uint  e;           // unused (slot = gl_WorkGroupID.y)
    uint  R;
    uint  K;           // must be % 128 == 0
    uint  row0;
    uint  row_stride;
    float wscale;
    uint  flags;       // unused
} pc;

shared float red[64];

float f8e4m3_to_f32(uint v) {
    uint sgn = v >> 7, ex = (v >> 3) & 0xFu, mn = v & 7u;
    float x = (ex == 0u) ? ldexp(float(mn) / 8.0, -6)
                         : ldexp(1.0 + float(mn) / 8.0, int(ex) - 7);
    return sgn != 0u ? -x : x;
}

void main() {
    const uint m   = gl_WorkGroupID.x;
    const uint r   = pc.row0 + m * pc.row_stride;
    const uint e   = uint(idx[gl_WorkGroupID.y]);
    const uint tid = gl_LocalInvocationID.x;

    const uint wr_base = (e * pc.R + r) * (pc.K >> 2);
    const uint sc_base = (e * pc.R + r) * (pc.K >> 7);

    float acc = 0.0;
    for (uint k = tid; k < pc.K; k += 64u) {
        uint word = w[wr_base + (k >> 2)];
        float wv = f8e4m3_to_f32((word >> ((k & 3u) * 8u)) & 0xFFu);
        uint sw = s[sc_base + (k >> 7)];
        float bs = ldexp(1.0, int((sw >> (((k >> 5) & 3u) * 8u)) & 0xFFu) - 127);
        acc += wv * bs * x[k];
    }

    red[tid] = acc;
    barrier();
    for (uint st = 32u; st > 0u; st >>= 1) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    if (tid == 0u)
        o[gl_WorkGroupID.y * gl_NumWorkGroups.x + m] = red[0];
}
