#version 460

// attn_scores_seq.comp — batched causal attention logits for chunked prefill.
//
// Per-row mirror of attn_scores.comp: query row t (position pos0+t) attends
// over the KV cache at absolute rows j in [j0_t, pos0+t] with
//   j0_t = full ? 0 : max(0, pos0+t+1 - swa)
// Columns outside the causal window are written as -1e30 (exact 0 after the
// row softmax). rel bias uses d = (pos0+t) - j, valid for 0 <= d < ext.
//
// grid = (HQ, ceil(n/64), T): h = wgid.x, jj = wgid.y*64+tid, t = wgid.z.
// n = pos0 + T (row width); pstride >= n+1 (sink slot at index n).
//   b0 ro Q[T*HQ*DH]  b1 ro K[len*HK*DH]  b2 ro REL[T*HQ*ext]  b3 wo P[T*HQ*pstride]

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuf  { float q[]; };
layout(set = 0, binding = 1, std430) readonly buffer KBuf  { float k[]; };
layout(set = 0, binding = 2, std430) readonly buffer RLBuf { float rel[]; };
layout(set = 0, binding = 3, std430) writeonly buffer PBuf { float p[]; };

layout(push_constant) uniform Pc {
    uint hq;
    uint hk;
    uint dh;
    uint n;        // row width = pos0 + T
    uint pos0;     // first position of the chunk
    uint ext;      // rel_extent (1024)
    uint pstride;  // >= n+1
    uint swa;      // sliding_window_size
    uint flags;    // bit0: FULL (no sliding window)
} pc;

void main() {
    const uint h  = gl_WorkGroupID.x;
    const uint t  = gl_WorkGroupID.z;
    const uint jj = gl_WorkGroupID.y * 64u + gl_LocalInvocationID.x;
    if (jj >= pc.n) return;

    const uint j     = jj;
    const uint post  = pc.pos0 + t;                    // query position
    const uint j0    = ((pc.flags & 1u) != 0u)
                       ? 0u
                       : (post + 1u > pc.swa ? post + 1u - pc.swa : 0u);

    if (j > post || j < j0) {
        p[(t * pc.hq + h) * pc.pstride + jj] = -1e30;
        return;
    }

    const uint g  = h * pc.hk / pc.hq;
    const float scale = 1.0 / sqrt(float(pc.dh));
    const uint qb = t * (pc.hq * pc.dh) + h * pc.dh;
    const uint kb = j * (pc.hk * pc.dh) + g * pc.dh;
    float s = 0.0;
    for (uint d = 0u; d < pc.dh; d++) s += q[qb + d] * k[kb + d];
    s *= scale;

    const int dd = int(post) - int(j);
    if (dd >= 0 && dd < int(pc.ext))
        s += rel[t * (pc.hq * pc.ext) + h * pc.ext + uint(dd)];

    p[(t * pc.hq + h) * pc.pstride + jj] = s;
}
