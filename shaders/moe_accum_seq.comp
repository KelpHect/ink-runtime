#version 460

// moe_accum_seq.comp — batched per-expert finalize (softcapped SwiGLU +
// weighted down-proj), slot-indexed, for chunked prefill.
//
// Identical math to moe_accum_slot.comp; gl_WorkGroupID.y is the prompt
// row t:
//   e  = idx[t*pc.ktop + pc.e]      ws = wt[t*pc.ktop + pc.e]
//   a[mm] = softcap(gate[t*gstride + mm], gcap) * sigmoid(gate)
//           * softcap(up[t*gstride + mm], ucap)      (sigmoid sees RAW gate)
//   out[t*pc.R + r] += ws * dot(W2[e,r,:], a)      (K = I = 1152)
// GATE/UP are bound pre-offset by +s*I (slot s), so the shader reads from
// row base t*gstride = t*ktop*I.
// grid = (D, T). quant: 0 = NVFP4, 1 = MXFP8 (same dequant as base).
//   b0 ro GATE  b1 ro UP  b2 ro W2  b3 ro S2  b4 ro AMAX  b5 ro OSD
//   b6 rw OUT   b7 ro IDX  b8 ro WT

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer GTBuf { float gt[]; };
layout(set = 0, binding = 1, std430) readonly buffer UPBuf { float up[]; };
layout(set = 0, binding = 2, std430) readonly buffer WBuf  { uint  w[]; };
layout(set = 0, binding = 3, std430) readonly buffer SBuf  { uint  s[]; };
layout(set = 0, binding = 4, std430) readonly buffer ABuf  { float amax[]; };
layout(set = 0, binding = 5, std430) readonly buffer O2Buf { float osd[]; };
layout(set = 0, binding = 6, std430) buffer OBuf           { float o[]; };
layout(set = 0, binding = 7, std430) readonly buffer IBuf  { int   idx[]; };
layout(set = 0, binding = 8, std430) readonly buffer WtBuf { float wt[]; };

layout(push_constant) uniform Pc {
    uint  e;         // SLOT index within a row
    uint  R;         // W2 rows per expert = D (2304); also out row stride
    uint  I;         // inner dim (1152)
    uint  quant;     // 0 = NVFP4, 1 = MXFP8
    float gcap;
    float ucap;
    float wscale;    // unused (wt carries it)
    uint  ktop;      // idx slots per row (8)
    uint  gstride;   // gate/up row stride = ktop*I
} pc;

shared float red[64];
shared float a[1152];

const float E2M1[16] = float[16](0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
                                 -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0);

float f8e4m3_to_f32(uint v) {
    uint sgn = v >> 7, ex = (v >> 3) & 0xFu, mn = v & 7u;
    float x = (ex == 0u) ? ldexp(float(mn) / 8.0, -6)
                         : ldexp(1.0 + float(mn) / 8.0, int(ex) - 7);
    return sgn != 0u ? -x : x;
}
float softcap(float x, float c) { return c * tanh(x / c); }

void main() {
    const uint r   = gl_WorkGroupID.x;
    const uint t   = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationID.x;
    const uint e   = uint(idx[t * pc.ktop + pc.e]);
    const float ws = wt[t * pc.ktop + pc.e];
    const uint gb  = t * pc.gstride;

    for (uint mm = tid; mm < pc.I; mm += 64u) {
        float g = gt[gb + mm], u = up[gb + mm];
        a[mm] = softcap(g, pc.gcap) * (1.0 / (1.0 + exp(-g))) * softcap(u, pc.ucap);
    }
    barrier();

    const uint kv = pc.I;
    float acc = 0.0;
    if (pc.quant == 0u) {
        const uint wb = (e * pc.R + r) * (kv >> 3);
        const uint sb = (e * pc.R + r) * (kv >> 6);
        for (uint k = tid; k < kv; k += 64u) {
            uint word = w[wb + (k >> 3)];
            uint bytev = (word >> (((k >> 1) & 3u) * 8u)) & 0xFFu;
            uint nib = (k & 1u) != 0u ? (bytev >> 4) : (bytev & 0xFu);
            uint sw = s[sb + (k >> 6)];
            float bs = f8e4m3_to_f32((sw >> (((k >> 4) & 3u) * 8u)) & 0xFFu);
            acc += E2M1[nib] * bs * a[k];
        }
    } else {
        const uint wb = (e * pc.R + r) * (kv >> 2);
        const uint sb = (e * pc.R + r) * (kv >> 7);
        for (uint k = tid; k < kv; k += 64u) {
            float wv = f8e4m3_to_f32((w[wb + (k >> 2)] >> ((k & 3u) * 8u)) & 0xFFu);
            uint sw = s[sb + (k >> 7)];
            float bs = ldexp(1.0, int((sw >> (((k >> 5) & 3u) * 8u)) & 0xFFu) - 127);
            acc += wv * bs * a[k];
        }
    }

    red[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    if (tid == 0u) {
        float res = red[0];
        if (pc.quant == 0u) res *= amax[e] / osd[0];
        o[t * pc.R + r] += ws * res;
    }
}
