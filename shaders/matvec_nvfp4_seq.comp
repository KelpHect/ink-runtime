#version 460

// matvec_nvfp4_seq.comp — batched expert GEMV over NVFP4, slot-indexed.
//
// Identical math to matvec_nvfp4_slot.comp; gl_WorkGroupID.y is the prompt
// row t. The router id comes from the device-resident per-row IDX buffer:
//   e = idx[t*pc.ktop + pc.e]   (pc.e = slot, pc.ktop = experts/token = 8)
//   x = X + t*K;  out[(t*pc.ktop + pc.e)*pc.M + m] = res * (amax[e]/osd[0])
// grid = (M, T), M = pc.M output rows per slot (gate/up: M = I = 1152).
// flags bit0 ACCUMULATE identical to base.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer WBuf  { uint  w[]; };
layout(set = 0, binding = 1, std430) readonly buffer SBuf  { uint  s[]; };
layout(set = 0, binding = 2, std430) readonly buffer ABuf  { float amax[]; };
layout(set = 0, binding = 3, std430) readonly buffer OBuf  { float osd[]; };
layout(set = 0, binding = 4, std430) readonly buffer XBuf  { float x[]; };
layout(set = 0, binding = 5, std430) buffer OBuf2          { float o[]; };
layout(set = 0, binding = 6, std430) readonly buffer IBuf  { int   idx[]; };

layout(push_constant) uniform Pc {
    uint  e;           // SLOT index within a row
    uint  R;           // rows of W per expert
    uint  K;           // logical elements per row (K % 64 == 0)
    uint  row0;
    uint  row_stride;
    float wscale;
    uint  flags;       // bit0: ACCUMULATE
    uint  ktop;        // idx slots per row (8)
    uint  M;           // out rows per slot
} pc;

shared float red[64];

const float E2M1[16] = float[16](0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
                                 -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0);

float f8e4m3_to_f32(uint v) {
    uint sgn = v >> 7, ex = (v >> 3) & 0xFu, mn = v & 7u;
    float x = (ex == 0u) ? ldexp(float(mn) / 8.0, -6)
                         : ldexp(1.0 + float(mn) / 8.0, int(ex) - 7);
    return sgn != 0u ? -x : x;
}

void main() {
    const uint m = gl_WorkGroupID.x;
    const uint t = gl_WorkGroupID.y;
    const uint r = pc.row0 + m * pc.row_stride;
    const uint e = uint(idx[t * pc.ktop + pc.e]);
    const uint tid = gl_LocalInvocationID.x;

    const uint wr_base = (e * pc.R + r) * (pc.K >> 3);
    const uint sc_base = (e * pc.R + r) * (pc.K >> 6);
    const uint xb = t * pc.K;

    float acc = 0.0;
    for (uint k = tid; k < pc.K; k += 64u) {
        uint word = w[wr_base + (k >> 3)];
        uint bytev = (word >> (((k >> 1) & 3u) * 8u)) & 0xFFu;
        uint nib = (k & 1u) != 0u ? (bytev >> 4) : (bytev & 0xFu);
        uint sw = s[sc_base + (k >> 6)];
        float bs = f8e4m3_to_f32((sw >> (((k >> 4) & 3u) * 8u)) & 0xFFu);
        acc += E2M1[nib] * bs * x[xb + k];
    }

    red[tid] = acc;
    barrier();
    for (uint st = 32u; st > 0u; st >>= 1) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    if (tid == 0u) {
        float res = red[0] * (amax[e] / osd[0]);
        const uint ob = (t * pc.ktop + pc.e) * pc.M + m;
        if ((pc.flags & 1u) != 0u) o[ob] += pc.wscale * res;
        else                       o[ob] = pc.wscale * res;
    }
}
