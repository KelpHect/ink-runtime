#version 460

// vadd.comp — elementwise vector add: out[i] = a[i] + b[i].
//
// Used for the residual updates in graph.cpp::visit:
//   residual = x_in + a_out   (non-boundary layers)
//   partial  = residual + mo
// out may alias a or b. One thread per element. Dispatch: ceil(n/64).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer ABuf  { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer BBuf  { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OBuf { float o[]; };

layout(push_constant) uniform Pc { uint n; } pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    o[i] = a[i] + b[i];
}
